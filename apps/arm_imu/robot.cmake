# 三 IMU 三段手臂 APP：USART1 HL04 接大臂，CAN2 HL04 接前臂，板载 BMI088 位于手背。

include(${CMAKE_CURRENT_LIST_DIR}/../../modules/module_config.cmake)

set(MODULES_SINGLE BMI088 INS)
set(MODULES_GIMBAL "")
set(MODULES_CHASSIS "")
# DJI C 板的 PF6/TIM10_CH1 连接 BMI088 加热电阻；恒温降低开机自热导致的陀螺零偏变化。
set(BMI088_TEMP_ENABLE             1)
set(BMI088_TEMP_SET                35.0)
set(ARM_DUAL_IMU_ENABLE             1)
set(ARM_DUAL_IMU_UART               huart1)
set(ARM_DUAL_IMU_UART_BAUD          921600)
# HI04 出厂值为 115200；模块未保存 921600 配置时自动回退到出厂波特率。
set(ARM_DUAL_IMU_UART_FALLBACK_BAUD 115200)
# 当前 HL04 实测配置：CANopen、500 kbit/s、节点 8、TPDO4 四元数标准帧。
set(ARM_DUAL_IMU_CAN_RX_ID          0x488)
set(ARM_DUAL_IMU_CAN_PRESCALER      6)
set(ARM_DUAL_IMU_TASK_STACK_SIZE    2048)
set(ARM_DUAL_IMU_TASK_PRIORITY      11)
# 数值 IK 固定 50 Hz；实机大姿态样本需要 17 次收敛，保留少量余量设为 20 次。
set(ARM_DUAL_IMU_IK_PERIOD_MS       20)
set(ARM_DUAL_IMU_IK_MAX_ITERATIONS  20)
set(ARM_DUAL_IMU_READ_TIMEOUT_MS    2)
set(ARM_DUAL_IMU_UART_RECOVERY_ENABLE 1)
set(ARM_DUAL_IMU_UART_STARTUP_GRACE_MS 2500)
set(ARM_DUAL_IMU_UPPER_TIMEOUT_MS   100)
set(ARM_DUAL_IMU_FOREARM_TIMEOUT_MS 100)
set(ARM_DUAL_IMU_HAND_TIMEOUT_MS    100)
set(ARM_DUAL_IMU_AUTO_ZERO_ENABLE   1)
set(ARM_DUAL_IMU_AUTO_ZERO_DELAY_MS 1000)
# 三段人体手臂模型；手长为腕部旋转中心到手部目标点，实测后只需修改这里。
set(ARM_IMU_UPPER_LENGTH_M          0.204)
set(ARM_IMU_FOREARM_LENGTH_M        0.120)
set(ARM_IMU_HAND_LENGTH_M           0.090)
set(ARM_IMU_DEBUG_ENABLE            1)
set(ARM_IMU_DEBUG_RTT_ENABLE        1)
set(ARM_IMU_DEBUG_RTT_CHANNEL       1)
set(ARM_IMU_DEBUG_POSE_RTT_CHANNEL  2)
set(ARM_IMU_DEBUG_RTT_BUFFER_SIZE   4096)
